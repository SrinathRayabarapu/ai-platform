# =============================================================================
# AI Platform — Environment Configuration
# =============================================================================
# Copy this file:  cp .env.example .env
# Edit .env with your machine-specific values (passwords, IPs, ports).
# The .env file is .gitignored — credentials never leave your machine.
# =============================================================================

# === General ===
COMPOSE_PROJECT_NAME=ai-lab

# Tailscale IP of the machine running this stack (used by Prometheus to
# scrape Spring Boot apps running on a remote dev machine).
# Set to the IP of THIS machine if everything runs locally.
AI_LAB_HOST=100.73.219.57

# Tailscale IP of the developer MacBook (where Spring Boot apps run during dev).
# Used by scripts/render-prometheus-config.sh unless AI_SERVICES_SCRAPE_TARGET is set.
DEV_MACHINE_IP=100.111.29.42

# Spring Boot management port for Prometheus scrape (Micrometer actuator).
SPRING_ACTUATOR_PORT=8081

# Optional: full "host:port" for Prometheus ai-services target (overrides DEV_MACHINE_IP + port).
# AI_SERVICES_SCRAPE_TARGET=100.111.29.42:8081

# === PostgreSQL (pgvector) ===
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_pass
POSTGRES_DB=ai_lab
POSTGRES_PORT=5432
POSTGRES_MEMORY_LIMIT=2G

# === Apache Kafka (KRaft, no ZooKeeper) ===
KAFKA_EXTERNAL_PORT=9094
KAFKA_RETENTION_HOURS=24
KAFKA_RETENTION_BYTES=1073741824
KAFKA_CLUSTER_ID=ai-lab-kafka-cluster-001
KAFKA_MEMORY_LIMIT=2G

# Host advertised to Kafka clients on the EXTERNAL listener (localhost if apps run on same host;
# set to this machine's Tailscale/LAN IP if clients are on another machine).
KAFKA_ADVERTISED_EXTERNAL_HOST=localhost

# === Redis ===
REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb
REDIS_MEMORY_LIMIT=768M

# === Prometheus ===
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=1GB
PROMETHEUS_MEMORY_LIMIT=512M

# === Grafana ===
GRAFANA_PORT=3000
GF_ADMIN_PASSWORD=admin1234
GRAFANA_MEMORY_LIMIT=512M

# === Kafka UI ===
KAFKA_UI_PORT=8080
KAFKA_UI_MEMORY_LIMIT=512M

# === pgAdmin4 ===
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@ailab.dev
PGADMIN_PASSWORD=admin
PGADMIN_MEMORY_LIMIT=512M

# === RedisInsight ===
REDISINSIGHT_PORT=5540
REDISINSIGHT_MEMORY_LIMIT=256M

# === node-exporter ===
NODE_EXPORTER_MEMORY_LIMIT=128M

# === cAdvisor ===
CADVISOR_MEMORY_LIMIT=256M

# =============================================================================
# EXTENDED PROFILE (activate with: docker compose --profile extended up -d)
# Recommended: 32 GB RAM for comfortable headroom.
# =============================================================================

# === MinIO (S3-compatible object storage) ===
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=minio123
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_MEMORY_LIMIT=512M

# === Loki (log aggregation) ===
# LOKI_PORT=3100
# LOKI_MEMORY_LIMIT=512M

# === Promtail (log collector) ===
# PROMTAIL_MEMORY_LIMIT=128M

# === Portainer (Docker management UI) ===
# PORTAINER_PORT=9443
# PORTAINER_MEMORY_LIMIT=256M

# === Traefik (reverse proxy) ===
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_DASHBOARD_PORT=8181
# TRAEFIK_MEMORY_LIMIT=128M
