{
  "uid": "ai-token-usage",
  "title": "AI Token Usage & Request Tracking",
  "tags": ["ai-lab", "tokens", "ai-services"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Token Consumption",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Total Prompt Tokens",
      "description": "Cumulative prompt tokens sent to the LLM across all operations",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(ai_tokens_prompt_total)",
          "legendFormat": "Prompt Tokens",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 200000 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Completion Tokens",
      "description": "Cumulative completion tokens generated by the LLM",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(ai_tokens_completion_total)",
          "legendFormat": "Completion Tokens",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 200000 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Requests",
      "description": "Cumulative successful AI requests",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(ai_requests_total)",
          "legendFormat": "Requests",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Errors",
      "description": "Cumulative fallback-triggered errors",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "sum(ai_requests_errors_total)",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error Rate",
      "description": "Errors / Total requests — should be near 0%",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "expr": "sum(ai_requests_errors_total) / clamp_min(sum(ai_requests_total) + sum(ai_requests_errors_total), 1) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto" }
    },
    {
      "type": "row",
      "title": "Token Rate Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token Consumption Rate (per minute)",
      "description": "Prompt vs Completion tokens per minute, broken down by operation",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(ai_tokens_prompt_total[5m])) * 60",
          "legendFormat": "Prompt — {{operation}}",
          "refId": "A"
        },
        {
          "expr": "sum by (operation) (rate(ai_tokens_completion_total[5m])) * 60",
          "legendFormat": "Completion — {{operation}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto",
            "lineWidth": 2,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request Rate (per minute)",
      "description": "AI requests per minute by operation (chat, classify, summarize)",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(ai_requests_total[5m])) * 60",
          "legendFormat": "{{operation}}",
          "refId": "A"
        },
        {
          "expr": "sum by (operation) (rate(ai_requests_errors_total[5m])) * 60",
          "legendFormat": "error — {{operation}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto",
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^error" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.fillOpacity", "value": 40 }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Per-Operation Breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Requests by Operation (last 1h)",
      "description": "Distribution of AI requests across chat, classify, and summarize",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "sum by (operation) (increase(ai_requests_total[1h]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Prompt Tokens by Operation (last 1h)",
      "description": "Which operations consume the most prompt tokens",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "targets": [
        {
          "expr": "sum by (operation) (increase(ai_tokens_prompt_total[1h]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Completion Tokens by Operation (last 1h)",
      "description": "Which operations generate the most completion tokens",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "targets": [
        {
          "expr": "sum by (operation) (increase(ai_tokens_completion_total[1h]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      }
    },
    {
      "type": "row",
      "title": "Cumulative Tokens Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cumulative Prompt Tokens",
      "description": "Running total of prompt tokens — useful for daily/weekly spend tracking",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (operation) (ai_tokens_prompt_total)",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "stacking": { "mode": "normal" },
            "lineWidth": 1
          },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cumulative Completion Tokens",
      "description": "Running total of completion tokens — the cost driver for paid APIs",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum by (operation) (ai_tokens_completion_total)",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "stacking": { "mode": "normal" },
            "lineWidth": 1
          },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Tokens Per Request (Efficiency)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Avg Tokens Per Request (5m window)",
      "description": "Average prompt + completion tokens per request — detects runaway prompts",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(ai_tokens_prompt_total[5m])) / clamp_min(sum by (operation) (rate(ai_requests_total[5m])), 0.001)",
          "legendFormat": "Prompt — {{operation}}",
          "refId": "A"
        },
        {
          "expr": "sum by (operation) (rate(ai_tokens_completion_total[5m])) / clamp_min(sum by (operation) (rate(ai_requests_total[5m])), 0.001)",
          "legendFormat": "Completion — {{operation}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "short"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Operation Summary (last 1h)",
      "description": "At-a-glance summary: requests, tokens, and errors per operation",
      "datasource": { "type": "prometheus", "uid": "ai-lab-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "sum by (operation) (increase(ai_requests_total[1h]))",
          "legendFormat": "{{operation}}",
          "refId": "requests",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (operation) (increase(ai_tokens_prompt_total[1h]))",
          "legendFormat": "{{operation}}",
          "refId": "prompt",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (operation) (increase(ai_tokens_completion_total[1h]))",
          "legendFormat": "{{operation}}",
          "refId": "completion",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (operation) (increase(ai_requests_errors_total[1h]))",
          "legendFormat": "{{operation}}",
          "refId": "errors",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "operation": "Operation",
              "Value #requests": "Requests",
              "Value #prompt": "Prompt Tokens",
              "Value #completion": "Completion Tokens",
              "Value #errors": "Errors"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Errors" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      }
    }
  ],
  "schemaVersion": 39
}
